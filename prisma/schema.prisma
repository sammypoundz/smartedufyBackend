// ============================================================
// SUBSCRIPTION & BILLING SYSTEM (Super Admin managed)
// ============================================================
// Canonical plans: FREE | PAY_PER_STUDENT (STUDENT_BASED) | FIXED tiers
// (Standard 1–500 / Growth 501–2,000 / Enterprise 2,000+). Prices are
// configurable per tier AND per billing frequency via PlanPriceOverride.
// schools buy token top-ups from configurable TokenPackage rows.

// ---- Per-tier, per-frequency price overrides ----
// billingFrequency: MONTHLY | TERMLY | ANNUALLY | BIENNIALLY
model PlanPriceOverride {
  id               String           @id @default(auto()) @map("_id") @db.ObjectId
  planId           String           @db.ObjectId
  plan             SubscriptionPlan @relation(fields: [planId], references: [id])
  billingFrequency String
  price            Float // NGN per cycle for this tier+frequency
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([planId, billingFrequency])
  @@map("plan_price_overrides")
}

// ---- Configurable AI token packages (schools buy these top-ups) ----
model TokenPackage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String   @unique // e.g. "Starter"
  tokens    Int // token quantity
  price     Float // NGN
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases PackagePurchase[]
  biaTransactions BiaPaymentTransaction[]

  @@map("token_packages")
}

// ---- Invoice payments recorded against a generated invoice ----
// model SubscriptionPayment covers plan payments; PackagePurchase covers
// token top-ups; a paid Invoice stores paymentRef directly.

// ============================================================
// BACKFILL SEED NOTE — canonical fixed tiers are seeded by
// prisma/seedBillingPlans.ts with these PlanPriceOverride rows:
//   Free (FREE)            ₦0 all frequencies
//   Pay Per Student        ₦200/student/term (STUDENT_BASED)
//   Standard  (FIXED)      ₦25,000/mo · ₦70,000/term · ₦250,000/yr
//   Growth    (FIXED)      ₦60,000/mo · ₦170,000/term · ₦600,000/yr
//   Enterprise(FIXED)      ₦150,000/mo · ₦430,000/term · ₦1,500,000/yr
// ============================================================
// model SubscriptionPayment covers plan payments; PackagePurchase covers
// token top-ups; this binds a payment to a specific Invoice.

// ---- A token package purchase (credited AFTER server-side verification) ----
model PackagePurchase {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  schoolId   String       @db.ObjectId
  packageId  String       @db.ObjectId
  package    TokenPackage @relation(fields: [packageId], references: [id])
  tokens     Int
  amount     Float
  method     String       @default("TRANSFER") // TRANSFER | CARD | USSD | CASH
  reference  String? // bank transfer / gateway reference
  status     String       @default("PENDING") // PENDING | VERIFIED | REJECTED
  // Verified purchases credit the wallet with reference TKGP-<purchaseId> —
  // the ledger unique (schoolId, reference) makes crediting idempotent.
  verifiedAt DateTime?
  verifiedBy String?      @db.ObjectId
  createdAt  DateTime     @default(now())

  @@index([schoolId, createdAt])
  @@index([status])
  @@map("package_purchases")
}

// ---- BIA CONNECT hosted-checkout payment for Edufy AI token purchases ----
// Created PENDING before the BIA checkout session is initialised. Tokens are
// credited ONLY by biaPaymentService.fulfill(), which requires a successful
// server-side BIA verification (amount, currency and references all matching).
// Idempotency: fulfilment is guarded by a unique TokenLedger reference
// (BIAPAY-<internalReference>), so duplicate webhooks / double verification /
// simultaneous confirmations can never credit a wallet twice.
model BiaPaymentTransaction {
  id                String    @id @default(auto()) @map("_id") @db.ObjectId
  schoolId          String    @db.ObjectId
  userId            String    @db.ObjectId // initiating user
  packageId         String?   @db.ObjectId // token package chosen (null = legacy)

  provider          String    @default("BIA")
  purpose           String    @default("EDUFY_AI_TOKEN_PURCHASE")

  // References — internalReference is ours, the others come from BIA.
  internalReference String    @unique
  biaReference      String?   @unique
  merchantReference String? // second reference BIA echoes back

  amount            Float // NGN, calculated server-side from TokenPackage
  currency          String    @default("NGN")
  tokenQuantity     Int

  status            String    @default("PENDING") // PENDING | SUCCESS | FAILED | EXPIRED | REVERSED
  authorizationUrl  String?
  checkoutExpiresAt DateTime?

  customerEmail     String?
  customerName      String?
  customerPhone     String?

  paidAt            DateTime?
  // Fulfilled = tokens credited to the wallet exactly once.
  fulfilled         Boolean   @default(false)
  fulfilledAt       DateTime?
  fulfillAttempts   Int       @default(0)
  lastFulfillError  String?

  verificationLog   Json? // history of verify/webhook attempts (no secrets)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  school  School       @relation(fields: [schoolId], references: [id])
  user    User         @relation(fields: [userId], references: [id])
  package TokenPackage? @relation(fields: [packageId], references: [id])

  @@index([schoolId, status])
  @@index([createdAt])
  @@map("bia_payment_transactions")
}

// ---- Invoice for a subscription cycle (PPS snapshot or fixed tier) ----
model Invoice {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  invoiceNo        String    @unique // INV-YYYY-NNNNNN
  schoolId         String    @db.ObjectId
  subscriptionId   String?   @db.ObjectId
  // Dedup: only one invoice per school per billing period key
  periodKey        String // e.g. "2026-01" | "2026-T1" — unique with schoolId
  billingModel     String // FREE | PAY_PER_STUDENT | FIXED_SUBSCRIPTION
  billingFrequency String    @default("MONTHLY")
  description      String?
  // Pricing breakdown
  studentSnapshot  Int? // PPS: locked at generation; later enrolment
  // changes do NOT touch this invoice
  pricePerStudent  Float? // NGN per student used for this invoice
  amount           Float
  currency         String    @default("NGN")
  status           String    @default("PENDING") // PENDING | PAID | OVERDUE | VOID
  dueDate          DateTime
  paidAt           DateTime?
  paymentRef       String? // SubscriptionPayment/PackagePurchase linkage
  paidAmount       Float     @default(0)
  createdBy        String?   @db.ObjectId // platform user (manual generation)
  source           String    @default("AUTO") // AUTO (cron) | MANUAL (super admin)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([schoolId, periodKey])
  @@index([schoolId, status])
  @@index([status, dueDate])
  @@map("invoices")
}

// ---- Immutable billing event log (allocation/renewal/invoice audit) ----
// Idempotency: unique (schoolId, eventKey) prevents double token allocation
// or double invoicing when the cron runs more than once.
model BillingEvent {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  type        String // INVOICE_GENERATED | PAYMENT_RECORDED | SUBSCRIPTION_RENEWED
  // | TOKENS_ALLOCATED | SUBSCRIPTION_EXPIRED | BILLING_CHANGED
  eventKey    String   @default("") // idempotency key (e.g. SUB-ALLOC-<subId>-2026-01)
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@unique([schoolId, eventKey])
  @@index([schoolId, type, createdAt])
  @@map("billing_events")
}
