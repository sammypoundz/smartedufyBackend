// ---- Subscription plans (platform-level, no schoolId) ----
model SubscriptionPlan {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  name             String   @unique
  description      String?
  // FIXED = flat fee per cycle | FREE = ₦0, no auto tokens | STUDENT_BASED = per-student-per-term
  type             String   @default("FIXED")
  // Monthly recurring price in NGN per school (FIXED type; 0 for FREE)
  monthlyPrice     Float
  // NGN per eligible student per term (STUDENT_BASED type)
  perStudentRate   Float?
  // AI tokens credited per successfully activated paid billing cycle
  aiTokenAllowance Int      @default(100)
  gracePeriodDays  Int      @default(7)
  isActive         Boolean  @default(true)
  maxStudents      Int? // capacity cap enforced server-side
  // Marketing copy shown to schools browsing available plans
  tagline          String?
  features         Json? // [{ label: string, comingSoon?: boolean }]
  featured         Boolean  @default(false) // shown as "Recommended"
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  subscriptions  Subscription[]
  priceOverrides PlanPriceOverride[]

  @@map("subscription_plans")
}

// ---- School subscriptions ----
model Subscription {
  id                   String           @id @default(auto()) @map("_id") @db.ObjectId
  schoolId             String           @db.ObjectId
  planId               String           @db.ObjectId
  plan                 SubscriptionPlan @relation(fields: [planId], references: [id])
  status               String           @default("ACTIVE")
  // ACTIVE | EXPIRED | TRIAL | SUSPENDED | PENDING_RENEWAL
  billingCycle         String           @default("MONTHLY")
  // MONTHLY | QUARTERLY | TERMLY | HALF_YEARLY | ANNUAL
  // Price per cycle actually charged (allows per-school overrides of the plan price)
  pricePerCycle        Float?
  // Per-school override of the plan's perStudentRate (STUDENT_BASED billing).
  // null = fall back to plan.perStudentRate.
  perStudentRateOverride Float?
  // Per-assignment token override. null = use the plan's default allowance.
  // Lets the super admin decide the bundled tokens (or zero) at assign time,
  // independent of the plan's own default.
  aiTokenAllowance     Int?
  // Term/year this cycle covers (STUDENT_BASED billing is tied to the school's term)
  schoolTermId         String?          @db.ObjectId
  studentSnapshotCount Int?
  startDate            DateTime         @default(now())
  endDate              DateTime
  trial                Boolean          @default(false)
  // Cycle lengths in months for computing end dates from payments
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  payments SubscriptionPayment[]

  @@unique([schoolId])
  @@index([status, endDate])
  @@map("subscriptions")
}

// ---- Verified subscription payments (the only revenue source for subs) ----
model SubscriptionPayment {
  id              String       @id @default(auto()) @map("_id") @db.ObjectId
  schoolId        String       @db.ObjectId
  subscriptionId  String       @db.ObjectId
  subscription    Subscription @relation(fields: [subscriptionId], references: [id])
  amount          Float
  method          String       @default("TRANSFER")
  // TRANSFER | CARD | USSD | CASH | ADJUSTMENT
  reference       String?
  verified        Boolean      @default(true) // false = pending reconciliation
  aiTokensGranted Int          @default(0) // AI allowance credited on this verified payment
  paidAt          DateTime     @default(now())
  note            String?
  createdAt       DateTime     @default(now())

  @@index([schoolId, paidAt])
  @@index([paidAt])
  @@map("subscription_payments")
}

// ---- Edufy AI token wallet (one per school) ----
// SPLIT BALANCES: `balance` = total settled tokens available (the AI gate).
// subscriptionTokens = the portion granted by subscription cycles / grants —
// consumed FIRST. purchasedTokens = bought tokens — consumed after subscription
// tokens run dry, never expire and carry forward across renewals.
model TokenWallet {
  id                 String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId           String   @unique @db.ObjectId
  balance            Int      @default(0) // settled tokens available (= sub + purchased)
  reserved           Int      @default(0) // held for in-flight AI operations
  subscriptionTokens Int      @default(0) // deducted FIRST (allocation priority)
  purchasedTokens    Int      @default(0) // deducted after subscription tokens
  lifetimePurchased  Int      @default(0)
  lifetimeAllocated  Int      @default(0) // subscription/grant tokens credited, lifetime
  lifetimeConsumed   Int      @default(0)
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  ledger TokenLedger[]

  @@map("token_wallets")
}

// ---- Immutable token ledger (purchase / charge / credit / reversal) ----
model TokenLedger {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId     String   @db.ObjectId
  type         String // PURCHASE | CHARGE | CREDIT | REFUND | RELEASE | ADJUSTMENT
  amount       Int // signed: positive adds tokens, negative removes
  balanceAfter Int
  reference    String? // idempotency key: payment ref or AI log id
  description  String?
  metadata     Json?
  createdAt    DateTime @default(now())

  wallet   TokenWallet @relation(fields: [walletId], references: [id])
  walletId String      @db.ObjectId

  @@unique([schoolId, reference]) // idempotency at the DB level
  @@index([schoolId, createdAt])
  @@map("token_ledger")
}

// ---- AI usage & cost log (one row per AI operation) ----
model AiUsageLog {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId         String?  @db.ObjectId // null for platform (super-admin onboarding)
  userId           String?  @db.ObjectId
  operation        String // RESULT_SCAN | ONBOARDING_EXTRACT | ...
  provider         String   @default("gemini")
  model            String
  status           String // SUCCESS | FAILED
  requests         Int      @default(1)
  retries          Int      @default(0)
  inputTokens      Int      @default(0)
  outputTokens     Int      @default(0)
  costUsd          Float    @default(0)
  costUsdEstimated Boolean  @default(true)
  exchangeRate     Float    @default(1600) // USD -> NGN
  costNgn          Float    @default(0)
  tokensCharged    Int      @default(0) // school tokens actually charged
  revenueNgn       Float    @default(0) // tokensCharged × token price
  processingMs     Int?
  errorMessage     String?
  createdAt        DateTime @default(now())

  @@index([schoolId, createdAt])
  @@index([operation, createdAt])
  @@map("ai_usage_logs")
}

// ---- Platform expenses (AI costs, hosting, etc.) ----
model PlatformExpense {
