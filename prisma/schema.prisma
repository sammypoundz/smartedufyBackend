}

// ---- Audit trail for every sensitive platform action ----
model PlatformAuditLog {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  actorId     String   @db.ObjectId // PlatformUser id
  actorName   String?
  actorRole   String?
  action      String // e.g. SCHOOL_SUSPEND, WALLET_ADJUST, PLAN_CREATE, LOGIN
