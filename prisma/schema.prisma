generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// ========== TENANT (SCHOOL) ==========
model School {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  subdomain String?  @unique
  logoUrl   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  users                     User[]
  roles                     RoleDef[]
  students                  Student[]
  teachers                  Teacher[]
  parents                   Parent[]
  parentStudentLinks        ParentStudentLink[]
  classes                   Class[]
  arms                      Arm[]
  subjects                  Subject[]
  subjectTeachers           SubjectTeacher[]
  subjectArms               SubjectArm[]
  studentSubjects           StudentSubject[]
  skills                    Skill[]
  armSkills                 ArmSkill[]
  subjectSkills             SubjectSkill[]
  attendances               Attendance[]
  timetableEntries          TimetableEntry[]
  results                   Result[]
  teacherSubjectAssignments TeacherSubjectAssignment[]
  teacherSlotPreferences    TeacherSlotPreference[]
  timetableReviews          TimetableReview[]
  gradingScales             GradingScale[]
  gradingScaleGroups        GradingScaleGroup[]
  assessmentFormats         AssessmentFormat[]
  topics                    Topic[]
  lessonPlans               LessonPlan[]
  feeStructures             FeeStructure[]
  feePayments               FeePayment[]
  studentFees               StudentFee[]
  messages                  Message[]
  expenses                  Expense[]
  budgets                   Budget[]
  payrolls                  Payroll[]
  tests                     Test[]
  questions                 Question[]
  testAttempts              TestAttempt[]
  academicYears             AcademicYear[]
  biaTransactions           BiaPaymentTransaction[]
  terms                     Term[]
  promotionHistories        StudentPromotionHistory[]
  inventoryItems            InventoryItem[]

  auditLogs    AuditLog[]
  questionDocs QuestionDoc[]

  // NEW: Settings models
  promotionRules      PromotionRule[]
  reportCardTemplates ReportCardTemplate[]
  bankDetail          BankDetail? // one-to-one (unique constraint on schoolId)
  idGeneratorConfigs  IdGeneratorConfig[]
}

// ========== USER ==========
model User {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId     String   @db.ObjectId
  school       School   @relation(fields: [schoolId], references: [id])
  name         String?
  email        String   @unique
  phone        String?
  password     String
  isActive     Boolean  @default(true)
  // Auto-generated or manually assigned ID (e.g. STU-2025-0001), unique per school.
  userIdCode   String?
  role         Role     @default(STUDENT)
  // Multi-role support: all roles held by this user (system + custom).
  roles        String[] @default([])
  // Page privileges granted to this user directly (extra, on top of role privileges)
  allowedPages String[] @default([])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student        Student?
  parent         Parent?
  teacher        Teacher?
  payrollEntries Payroll[]
  biaTransactions BiaPaymentTransaction[]
  messagesSent   Message[]     @relation("sender")
  auditLogs      AuditLog[]
  questionDocs   QuestionDoc[]

  @@index([schoolId, userIdCode])
  @@map("users")
}

// ========== STUDENT ==========
model Student {
  id                   String    @id @default(auto()) @map("_id") @db.ObjectId
  schoolId             String    @db.ObjectId
  school               School    @relation(fields: [schoolId], references: [id])
  name                 String
  gender               String
  dateOfBirth          DateTime?
  address              String?
  admissionNumber      String?
  classId              String?   @db.ObjectId
  armId                String?   @db.ObjectId
  parentId             String?   @db.ObjectId
  guardianRelationship String?
  religion             String?
  isActive             Boolean   @default(true)
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @db.ObjectId

  class  Class?  @relation(fields: [classId], references: [id])
  arm    Arm?    @relation(fields: [armId], references: [id])
  parent Parent? @relation(fields: [parentId], references: [id])

  attendance       Attendance[]
  results          Result[]
  studentSubjects  StudentSubject[]
  promotionHistory StudentPromotionHistory[]
  testAttempts     TestAttempt[]
  feePayments      FeePayment[]
  assignedFees     StudentFee[]
  linkRequests     ParentStudentLink[]
}

// ========== PARENT ==========
model Parent {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  schoolId String  @db.ObjectId
  school   School  @relation(fields: [schoolId], references: [id])
  name     String
  phone    String?
  email    String  @unique

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @db.ObjectId

  children     Student[]
  linkRequests ParentStudentLink[]
}

// ========== PARENT–STUDENT LINK REQUESTS (mirrors Timetable workflow states) ==========
// Parents request to link a student to their account; admins approve/reject.
// Status flow: PENDING_REVIEW -> APPROVED | REJECTED | CHANGES_REQUESTED
model ParentStudentLink {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  schoolId String @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id])

  parentId String @db.ObjectId
  parent   Parent @relation(fields: [parentId], references: [id])

  studentId String  @db.ObjectId
  student   Student @relation(fields: [studentId], references: [id])

  status        String    @default("PENDING_REVIEW") // PENDING_REVIEW | APPROVED | REJECTED | CHANGES_REQUESTED
  requestedName String? // name as the parent typed it (audit aid)
  parentNote    String? // message from the parent
  reviewNote    String? // admin's note on reject / changes requested
  reviewedBy    String?   @db.ObjectId // admin user id
  reviewedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([parentId])
  @@index([studentId])
  @@index([status])
}

// ========== TEACHER ==========
model Teacher {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  phone     String?
  email     String   @unique
  gender    String? // MALE | FEMALE | OTHER (collected at registration)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) // backfilled at server start for pre-existing rows

  // Self-service profile setup (filled by the teacher after registration)
  teacherType        String? // SUBJECT_TEACHER | FORM_TEACHER | BOTH
  briefSubjects      Json? // { subjects: ["Mathematics"], classes: ["JSS 1 Gold"] }
  registrationStatus String  @default("APPROVED") // PENDING | APPROVED | REJECTED (self-registered teachers start PENDING)

  user   User   @relation(fields: [userId], references: [id])
  userId String @unique @db.ObjectId

  subjects             SubjectTeacher[]
  arms                 Arm[]
  subjectArms          SubjectArm[]
  timetableAssignments TeacherSubjectAssignment[]
}

// ========== CLASS ==========
model Class {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  schoolId String @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id])
  name     String

  arms                Arm[]
  students            Student[]
  fromClassPromotions StudentPromotionHistory[] @relation("FromClassPromotions")
  toClassPromotions   StudentPromotionHistory[] @relation("ToClassPromotions")
  lessonPlans         LessonPlan[]
  tests               Test[]

  gradingScaleGroupId String?            @db.ObjectId
  gradingScaleGroup   GradingScaleGroup? @relation(fields: [gradingScaleGroupId], references: [id])
}

// ========== ARM ==========
model Arm {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String  @db.ObjectId
  school    School  @relation(fields: [schoolId], references: [id])
  letter    String
  alias     String?
  classId   String  @db.ObjectId
  teacherId String? @db.ObjectId

  class   Class    @relation(fields: [classId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  // Ordered period layout for this arm, e.g. ["8:00–8:45", "Break", "10:30–11:15"].
  // Slots whose name marks them as a break (break/lunch/recess) are treated as
  // non-instructional: no subject entries may exist on them.
  timeSlots String[] @default([])

  students           Student[]
  subjects           SubjectArm[]
  timetable          TimetableEntry[]
  teacherAssignments TeacherSubjectAssignment[]
  timetableReview    TimetableReview?
  skills             ArmSkill[]
  topics             Topic[]
  lessonPlans        LessonPlan[]
  results            Result[]
  fromPromotions     StudentPromotionHistory[]  @relation("fromArm")
  toPromotions       StudentPromotionHistory[]  @relation("toArm")
  tests              Test[]
}

// ========== SUBJECT ==========
model Subject {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String    @db.ObjectId
  school      School    @relation(fields: [schoolId], references: [id])
  name        String
  description String?
  createdAt   DateTime? @default(now())
  updatedAt   DateTime? @updatedAt

  teachers           SubjectTeacher[]
  arms               SubjectArm[]
  timetable          TimetableEntry[]
  teacherAssignments TeacherSubjectAssignment[]
  results            Result[]
  studentSubjects    StudentSubject[]
  topics             Topic[]
  skills             SubjectSkill[]
  lessonPlans        LessonPlan[]
  questions          Question[]
}

// ========== TIMETABLE WORKFLOW ==========

// Step 1 — Admin assigns each subject-arm to a teacher with allowed teaching
// days and the number of periods required per week.
model TeacherSubjectAssignment {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  schoolId       String    @db.ObjectId
  school         School    @relation(fields: [schoolId], references: [id])
  subjectId      String    @db.ObjectId
  armId          String    @db.ObjectId
  teacherId      String    @db.ObjectId
  allowedDays    String[] // e.g. ["Monday", "Wednesday"]
  periodsPerWeek Int       @default(1)
  createdAt      DateTime? @default(now())

  teacher Teacher                 @relation(fields: [teacherId], references: [id])
  subject Subject                 @relation(fields: [subjectId], references: [id])
  arm     Arm                     @relation(fields: [armId], references: [id])
  slots   TeacherSlotPreference[]

  @@unique([schoolId, subjectId, armId])
}

// Step 2/3 — Teacher-submitted available time slots for one assignment.
// Uniqueness on (assignment, day, slot) prevents double-picking their own
// slots; cross-assignment conflicts are validated in the API.
model TeacherSlotPreference {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  schoolId     String    @db.ObjectId
  school       School    @relation(fields: [schoolId], references: [id])
  assignmentId String    @db.ObjectId
  dayOfWeek    String
  timeSlot     String
  createdAt    DateTime? @default(now())

  assignment TeacherSubjectAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, dayOfWeek, timeSlot])
}

// Step 5/6 — Review/lock state of the timetable workflow for one arm.
model TimetableReview {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  schoolId         String    @db.ObjectId
  school           School    @relation(fields: [schoolId], references: [id])
  armId            String    @db.ObjectId
  status           String    @default("DRAFT") // DRAFT | PENDING_REVIEW | CHANGES_REQUESTED | APPROVED
  reviewNote       String?
  requestedChanges String?
  reviewedBy       String?   @db.ObjectId
  reviewedAt       DateTime?
  lockedAt         DateTime? // set when status becomes APPROVED
  createdAt        DateTime? @default(now())

  arm Arm @relation(fields: [armId], references: [id])

  @@unique([armId])
}

// ========== SUBJECT TEACHER (join) ==========
model SubjectTeacher {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String @db.ObjectId
  school    School @relation(fields: [schoolId], references: [id])
  subjectId String @db.ObjectId
  teacherId String @db.ObjectId

  subject Subject @relation(fields: [subjectId], references: [id])
  teacher Teacher @relation(fields: [teacherId], references: [id])

  @@unique([schoolId, subjectId, teacherId])
}

// ========== SUBJECT ARM (join) ==========
model SubjectArm {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String  @db.ObjectId
  school    School  @relation(fields: [schoolId], references: [id])
  subjectId String  @db.ObjectId
  armId     String  @db.ObjectId
  teacherId String? @db.ObjectId

  subject Subject  @relation(fields: [subjectId], references: [id])
  arm     Arm      @relation(fields: [armId], references: [id])
  teacher Teacher? @relation(fields: [teacherId], references: [id])

  @@unique([schoolId, subjectId, armId])
}

// ========== STUDENT SUBJECT (join) ==========
model StudentSubject {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String @db.ObjectId
  school    School @relation(fields: [schoolId], references: [id])
  studentId String @db.ObjectId
  subjectId String @db.ObjectId

  student Student @relation(fields: [studentId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])

  @@unique([studentId, subjectId])
}

// ========== SKILL ==========
model Skill {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String @db.ObjectId
  school      School @relation(fields: [schoolId], references: [id])
  name        String
  description String

  armSkills ArmSkill[]
  subjects  SubjectSkill[]
}

// ========== ARM SKILL (join) ==========
model ArmSkill {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  schoolId String @db.ObjectId
  school   School @relation(fields: [schoolId], references: [id])
  armId    String @db.ObjectId
  skillId  String @db.ObjectId

  arm   Arm   @relation(fields: [armId], references: [id])
  skill Skill @relation(fields: [skillId], references: [id])

  @@unique([armId, skillId])
}

// ========== SUBJECT SKILL (join) ==========
model SubjectSkill {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String @db.ObjectId
  school    School @relation(fields: [schoolId], references: [id])
  subjectId String @db.ObjectId
  skillId   String @db.ObjectId

  subject Subject @relation(fields: [subjectId], references: [id])
  skill   Skill   @relation(fields: [skillId], references: [id])

  @@unique([subjectId, skillId])
}

// ========== ATTENDANCE ==========
model Attendance {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id])
  date      DateTime
  studentId String   @db.ObjectId
  present   Boolean

  student Student @relation(fields: [studentId], references: [id])

  @@unique([studentId, date])
}

// ========== TIMETABLE ENTRY ==========
model TimetableEntry {
  id                 String  @id @default(auto()) @map("_id") @db.ObjectId
  schoolId           String  @db.ObjectId
  school             School  @relation(fields: [schoolId], references: [id])
  armId              String  @db.ObjectId
  dayOfWeek          String
  timeSlot           String
  subjectId          String? @db.ObjectId
  linkedAssignmentId String? @db.ObjectId // TeacherSubjectAssignment this entry was compiled from

  arm     Arm      @relation(fields: [armId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])

  @@unique([armId, dayOfWeek, timeSlot])
}

// ========== RESULT ==========
model Result {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId       String   @db.ObjectId
  school         School   @relation(fields: [schoolId], references: [id])
  studentId      String   @db.ObjectId
  subjectId      String   @db.ObjectId
  armId          String   @db.ObjectId
  term           String
  ca             Int // total CA = ca1 + ca2 + ca3 (kept for broadsheet/report compatibility)
  ca1            Int      @default(0) // First CA
  ca2            Int      @default(0) // Second CA
  ca3            Int      @default(0) // Third CA
  exam           Int
  total          Int
  score          Int
  grade          String?
  academicYearId String?  @db.ObjectId
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  student      Student       @relation(fields: [studentId], references: [id])
  subject      Subject       @relation(fields: [subjectId], references: [id])
  arm          Arm           @relation(fields: [armId], references: [id])
  academicYear AcademicYear? @relation(fields: [academicYearId], references: [id])

  @@unique([studentId, subjectId, armId, term, academicYearId])
}

// ========== GRADING SCALE GROUP ==========
// A school can define multiple grading scale groups (e.g. "WAEC Standard",
// "Nursery Scale") and assign each group to the classes that should use it.
model GradingScaleGroup {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  grades  GradingScale[]
  classes Class[]

  @@unique([schoolId, name])
}

// ========== GRADING SCALE ==========
model GradingScale {
  id        String             @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String             @db.ObjectId
  school    School             @relation(fields: [schoolId], references: [id])
  groupId   String?            @db.ObjectId
  group     GradingScaleGroup? @relation(fields: [groupId], references: [id])
  minScore  Int
  maxScore  Int
  grade     String
  points    Float?
  isDefault Boolean            @default(false)
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt
}

// ========== ASSESSMENT FORMAT ==========
model AssessmentFormat {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id])
  name      String
  ca        Int
  exam      Int
  total     Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, name]) // name unique per school
}

// ========== TOPIC ==========
model Topic {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String    @db.ObjectId
  school      School    @relation(fields: [schoolId], references: [id])
  subjectId   String    @db.ObjectId
  armId       String    @db.ObjectId
  title       String
  description String?
  completed   Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  subject Subject @relation(fields: [subjectId], references: [id])
  arm     Arm     @relation(fields: [armId], references: [id])
}

// ========== LESSON PLAN ==========
model LessonPlan {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String           @db.ObjectId
  school      School           @relation(fields: [schoolId], references: [id])
  title       String
  description String?
  classId     String           @db.ObjectId
  armId       String           @db.ObjectId
  subjectId   String           @db.ObjectId
  fileUrl     String
  fileName    String
  fileType    String
  status      LessonPlanStatus @default(DRAFT)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  class   Class   @relation(fields: [classId], references: [id])
  arm     Arm     @relation(fields: [armId], references: [id])
  subject Subject @relation(fields: [subjectId], references: [id])
}

// ========== FEE STRUCTURE ==========
model FeeStructure {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id])
  className   String
  armName     String?
  term        String
  breakdown   Json
  totalAmount Float
  deadline    DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  payments    FeePayment[]
  studentFees StudentFee[]
}

// ========== FEE PAYMENT ==========
model FeePayment {
  id             String           @id @default(auto()) @map("_id") @db.ObjectId
  schoolId       String           @db.ObjectId
  school         School           @relation(fields: [schoolId], references: [id])
  studentId      String           @db.ObjectId
  feeStructureId String           @db.ObjectId
  amountPaid     Float
  paymentDate    DateTime
  reference      String?
  paymentMethod  String
  breakdownItems Json
  status         FeePaymentStatus @default(PAID)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])
}

enum FeePaymentStatus {
  PAID
  PARTIAL
  PENDING
}

// ========== STUDENT FEE ==========
model StudentFee {
  id             String              @id @default(auto()) @map("_id") @db.ObjectId
  schoolId       String              @db.ObjectId
  school         School              @relation(fields: [schoolId], references: [id])
  studentId      String              @db.ObjectId
  feeStructureId String              @db.ObjectId
  amountAssigned Float
  amountPaid     Float               @default(0)
  status         FeeAssignmentStatus @default(PENDING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  student      Student      @relation(fields: [studentId], references: [id])
  feeStructure FeeStructure @relation(fields: [feeStructureId], references: [id])

  @@unique([studentId, feeStructureId])
}

enum FeeAssignmentStatus {
  PENDING
  PARTIAL
  PAID
}

// ========== MESSAGE ==========
model Message {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId   String   @db.ObjectId
  school     School   @relation(fields: [schoolId], references: [id])
  senderId   String   @db.ObjectId
  sender     User     @relation(fields: [senderId], references: [id], name: "sender")
  subject    String?
  content    String
  type       String // "email" or "sms"
  recipients Json // array of { type: "group" | "user", id: string, name?: string }
  sentAt     DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@map("messages")
}

// ========== EXPENSE ==========
model Expense {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String   @db.ObjectId
  school      School   @relation(fields: [schoolId], references: [id])
  description String
  amount      Float
  category    String
  date        DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ========== BUDGET ==========
model Budget {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId  String   @db.ObjectId
  school    School   @relation(fields: [schoolId], references: [id])
  category  String
  amount    Float
  monthYear String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([schoolId, category, monthYear])
}

// ========== PAYROLL ==========
model Payroll {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  schoolId    String        @db.ObjectId
  school      School        @relation(fields: [schoolId], references: [id])
  staffId     String        @db.ObjectId
  amount      Float
  month       String
  status      PayrollStatus @default(PENDING)
  paymentDate DateTime?
  notes       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  staff User @relation(fields: [staffId], references: [id], onDelete: Cascade)
}

enum PayrollStatus {
  PAID
  PENDING
  OVERDUE
}

// ========== TEST ==========
model Test {
  id            String     @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String     @db.ObjectId
  school        School     @relation(fields: [schoolId], references: [id])
  name          String
  classId       String     @db.ObjectId
  armId         String     @db.ObjectId
  subjects      String[]
  questionCount Int        @default(0)
  duration      Int        @default(0)
  status        TestStatus @default(DRAFT)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  class Class @relation(fields: [classId], references: [id])
  arm   Arm   @relation(fields: [armId], references: [id])

  questions Question[]
  attempts  TestAttempt[]
}

enum TestStatus {
  DRAFT
  PUBLISHED
}

// ========== QUESTION ==========
model Question {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId       String   @db.ObjectId
  school         School   @relation(fields: [schoolId], references: [id])
  testId         String   @db.ObjectId
  subjectId      String?  @db.ObjectId
  text           String
  options        String[]
  correctOption  Int
  marks          Int      @default(1)
  attachmentType String?
  attachmentUrl  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  test    Test     @relation(fields: [testId], references: [id])
  subject Subject? @relation(fields: [subjectId], references: [id])
}

