  name        String
  email       String    @unique
  password    String
  role        String    @default("ANALYTICS_VIEWER")
  // SUPER_ADMIN | FINANCE_ADMIN | ONBOARDING_OFFICER | SUPPORT_OFFICER | ANALYTICS_VIEWER
  isActive    Boolean   @default(true)
