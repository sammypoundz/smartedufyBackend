// ========== ID GENERATOR ==========
// Per-role auto ID configuration, e.g. format "STU-{YEAR}-{####}" with
// counter 42. One row per (school, role). {####} = zero-padded counter,
// {YEAR} = 4-digit year, {ROLE} = role name. Concurrency-safe: the counter
// is advanced inside a transaction with a read-your-write upsert.
model IdGeneratorConfig {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  schoolId      String   @db.ObjectId
  school        School   @relation(fields: [schoolId], references: [id])
  role          String // STUDENT | TEACHER | PARENT | ADMIN | PRINCIPAL | ...
  format        String   @default("{ROLE}-{####}") // e.g. STU-{YEAR}-{####}
  counter       Int      @default(0) // last used number for this role
  lastResetYear Int? // year of last {YEAR}-counter reset (yearly reset support)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([schoolId, role])
  @@map("id_generator_configs")
}

